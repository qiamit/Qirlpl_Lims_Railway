# ── Logs ──────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Dependencies & build ──────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.tsbuildinfo
coverage/

# ── Tooling caches ────────────────────────────────────────────────────
.vite/
frontend/.vite/
.eslintcache
.turbo/
.cache/
*.tgz

# ── Environment & secrets (never commit) ──────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/supabase-secrets.env
backend/supabase/.env
backend/supabase/.env.*
backend/supabase/.env.keys
credentials.json
*.pem
*.key
*.p12
*.pfx

# ── Supabase local / CLI ──────────────────────────────────────────────
backend/supabase/.temp/
backend/supabase/.branches/

# ── Vercel ────────────────────────────────────────────────────────────
.vercel/
frontend/.vercel/

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editors (keep shared workspace config only) ───────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Cursor: agent/deploy temp (keep shared MCP config) ────────────────
.cursor/*
!.cursor/mcp.json

# Cursor one-off deploy / MCP scratch files at repo root
.deploy-*
.invoke-*
.mcp-*
.tmp-*
.run-mcp-deploy.cjs

# Backend MCP / deploy scratch (local only)
backend/.call-mcp-args*.json
backend/.stdout-deploy-args.json
backend/.invoke-*
backend/.deploy-*
backend/.tmp-*

# Windows / editor swap
*.stackdump
*~
