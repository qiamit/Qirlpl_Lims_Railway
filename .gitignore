!.cursorrules

# Cursor / agent one-off deploy & scratch files
.deploy-*
.invoke-*
.mcp-*
.tmp-*
.run-mcp-deploy.cjs

# Backend MCP / deploy scratch (local only)
backend/.call-mcp-args*.json
backend/.stdout-deploy-args.json
backend/.invoke-*
backend/.deploy-*
backend/.tmp-*

# Local DB dump scratch (use versioned migrations instead)
backend/supabase/baseline_from_*.sql
*.sql.bak
*.dump
*.backup

# Windows / editor swap / temp
*.stackdump
*~
*.bak
*.tmp
*.temp
*.orig
